# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า CHANGE_ME (.env ไม่ถูก commit)
# สร้างค่าสุ่มได้ด้วย: openssl rand -hex 16

# รหัสผ่านของฐานข้อมูลใน docker-compose.yml (ผู้ใช้ campus)
POSTGRES_PASSWORD=CHANGE_ME

# postgres://<user>:<password>@<host>:<port>/<database>
# ฐานข้อมูลใน Docker บน VM Debian เข้าถึงจาก Windows ที่พอร์ต 5433 (VirtualBox forward 5433 -> 5432)
# (PostgreSQL ที่ติดตั้งบน Windows ใช้พอร์ต 5432 อยู่แล้ว จึงไม่ใช้ซ้ำ)
DATABASE_URL=postgres://campus:CHANGE_ME@localhost:5433/campus_market

# สร้างค่าสุ่มด้วย: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

PORT=3000

# เฟส 3 — ยืนยันตัวตน
# กุญแจเข้ารหัสรูปบัตร AES-256-GCM (hex 64 ตัว) · openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME
# กุญแจ HMAC ของเลขบัตร (ไม่เก็บเลขจริง) · openssl rand -hex 32 · เปลี่ยนแล้วค่าแฮชเก่าใช้เทียบไม่ได้
ID_HASH_SECRET=CHANGE_ME

# KMITL SSO (ไม่ใส่ = ปุ่ม SSO ตอบ 503) — สร้าง client ที่ https://developer.kmitl.ac.th
# redirect URI ที่ลงทะเบียน = ${PUBLIC_BASE_URL}/auth/kmitl/callback
# KMITL_CLIENT_ID=
# KMITL_CLIENT_SECRET=
# KMITL_API_KEY=        # Student API (ต้องขออนุมัติ) — ใช้ตรวจว่านักศึกษามีสถานะ "เรียน" (BR02)
# KMITL_SKIP_STUDENT_CHECK=true   # โหมดพัฒนาเท่านั้น: ข้ามการตรวจสถานะเมื่อยังไม่มี API key · ใช้ใน production ไม่ได้ (backend ไม่ยอมเริ่ม)
# KMITL_DUMMY=true      # โหมดพัฒนา: SSO + Student API จำลอง (นักศึกษา seed 3 คน ดู src/kmitl/dummy.ts) ไม่ต้องมี client/API key · ใช้ใน production ไม่ได้
# PUBLIC_BASE_URL=http://localhost:3000
